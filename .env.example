# Mapee Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase Configuration (Required for database features)
# Get these from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key for server-side operations (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenCelliD API Key (Optional - for cell tower data)
# Get from https://opencellid.org/
OPENCELLID_API_KEY=your-opencellid-api-key

# IPinfo API Token (Optional - for enhanced IP geolocation)
# Get from https://ipinfo.io/
IPINFO_TOKEN=your-ipinfo-token

# Encryption key for coordinate protection (32 bytes = 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# Upstash Redis Configuration (Required for API rate-limiting and caching)
# Get from https://upstash.com/
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
