# Mapee — apps/web Environment Variables
#
# This file belongs to the `apps/web` package (Next.js app) of the pnpm
# workspace. Copy it to `apps/web/.env.local` and fill in real values —
# never commit .env.local, and never put real credentials in this template.
#
# NOTE ON FUTURE REFACTOR: if/when the API routes under src/app/api/ are
# extracted into their own service, the server-only secrets below (the ones
# NOT prefixed NEXT_PUBLIC_) move with that service. The NEXT_PUBLIC_*
# variables stay with this Next.js app, since they are compiled into the
# browser bundle at build time and are meaningless to a backend-only service.
#
# LEGEND:
#   [server-only]     never sent to the browser, safe to keep secret
#   [public/browser]  NEXT_PUBLIC_ vars are inlined into client JS bundles —
#                      treat the value as visible to anyone who loads the page

# -----------------------------------------------------------------------------
# Supabase (database, auth-less data access)
# -----------------------------------------------------------------------------
# Get all three values from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
#
# Required together (URL + anon key). If either is missing, isSupabaseConfigured
# is false and the shared `supabase` client (src/lib/supabase.ts) is set to null.
# Any route/hook that depends on it degrades: e.g. src/app/api/pings/route.ts
# and src/app/api/pings/[id]/route.ts short-circuit and return an error
# response instead of reading/writing ping data, and src/app/api/stats/route.ts
# cannot serve aggregated stats. The app does not crash, but all
# database-backed features (submitting pings, fetching pings/stats) stop working.

# [public/browser] Your Supabase project URL. Required.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# [public/browser] Supabase "publishable" key (NEW key format). This is safe
# to expose in the browser — that's its purpose — but it only grants access
# allowed by your Row Level Security policies. Required.
# New-format publishable keys look like: sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# (Older projects may still show a legacy "anon" JWT — if so, rotate to the
# new publishable key from the Supabase dashboard's API settings page.)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# [server-only] Supabase "secret" key (NEW key format), used only by
# createServerClient() in src/lib/supabase.ts for privileged/admin operations.
# MUST NEVER be prefixed NEXT_PUBLIC_ and must never reach client bundles.
# Optional in the sense that the app boots without it, but if it is absent,
# createServerClient() logs "SUPABASE_SERVICE_ROLE_KEY is not set" and returns
# null — any code path needing an elevated/server client (bypassing RLS) will
# not work.
# New-format secret keys look like: sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# (Older projects may still show a legacy "service_role" JWT — rotate to the
# new secret key from the Supabase dashboard's API settings page.)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Coordinate encryption
# -----------------------------------------------------------------------------
# [server-only] AES-256-GCM key used by src/lib/encryption.ts to encrypt/
# decrypt stored lat/lng coordinates. Required for any code path that calls
# encrypt()/decrypt() or encryptCoordinate()/decryptCoordinate() — if it is
# missing or not exactly 64 hex characters (32 bytes), getKey() throws
# "ENCRYPTION_KEY must be a 64-character hex string (32 bytes)" and the
# request fails.
#
# Must be EXACTLY 64 hex characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# WARNING: Do not change this value once real data has been encrypted with
# it — any previously stored coordinates become permanently undecryptable
# ("Invalid encrypted string format" / decrypt failures) unless you first
# re-encrypt them with the old key. See the precedent migration at
# supabase/migrate-encryption.sql before rotating this key.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd

# -----------------------------------------------------------------------------
# Upstash Redis (rate limiting + response caching)
# -----------------------------------------------------------------------------
# [server-only] Get both from https://upstash.com/ (Redis REST API credentials).
# Optional — src/lib/redis.ts only instantiates the Redis client when BOTH
# vars are present; otherwise `redis` is exported as null. Consuming code
# (src/lib/rate-limit.ts, src/app/api/towers/route.ts, src/app/api/asn/route.ts)
# is written to fall back gracefully when redis is null: rate limiting uses an
# in-memory Map instead of Upstash, and tower/ASN responses use an in-memory
# Map cache instead of Redis. This means local dev works without Upstash, but
# the in-memory fallbacks do not share state across serverless instances/
# deployments, so rate limits and caches will not be consistent in production
# without these set.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token-placeholder

# -----------------------------------------------------------------------------
# OpenCelliD (cell tower data)
# -----------------------------------------------------------------------------
# [server-only] Get from https://opencellid.org/
# Optional. Consumed only by src/app/api/towers/route.ts. If absent, that
# route returns HTTP 503 with { error: "OPENCELLID_API_KEY not configured" }
# instead of proxying tower data — the rest of the app is unaffected.
OPENCELLID_API_KEY=your-opencellid-api-key-placeholder

# -----------------------------------------------------------------------------
# IPinfo (IP-based geolocation) — currently unused by code
# -----------------------------------------------------------------------------
# Get from https://ipinfo.io/
# NOT currently read anywhere in apps/web/src (grepped: no
# process.env.IPINFO_TOKEN reference). src/hooks/useLocationWaterfall.ts calls
# https://ipinfo.io/json unauthenticated and does not attach this token as a
# header or query param. Kept here as a placeholder for when that call is
# wired up to use a token (e.g. to raise ipinfo.io's free-tier rate limit);
# setting or omitting it has no effect on current behavior.
IPINFO_TOKEN=your-ipinfo-token-placeholder
