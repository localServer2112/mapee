{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is included for the Web Crypto API types (CryptoKey, BufferSource,
    // crypto.subtle) that lib/encryption.ts needs — Node 20 provides the
    // actual runtime global, but its own type declarations don't fully
    // cover it without DOM. Nothing here uses window/document.
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
