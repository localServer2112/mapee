{
  "name": "@mapee/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "tsx src/generate.ts",
    "generate:client": "openapi-typescript openapi.json -o generated/api.d.ts",
    "generate:all": "pnpm run generate && pnpm run generate:client",
    "build": "pnpm run generate:client",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm run generate:client && tsc --noEmit"
  },
  "dependencies": {
    "@mapee/core": "workspace:*",
    "zod": "^3.24.1",
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "eslint": "^8",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
